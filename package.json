{
  "name": "wanjiguanjia-tauri",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/inject-version.cjs && tsc && vite build",
    "build:dev": "node scripts/inject-version.cjs && vite build --mode development",
    "build:prod": "node scripts/inject-version.cjs && vite build --mode production",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run prebuild-check && node scripts/inject-version.cjs && tauri build",
    "tauri:build:debug": "npm run prebuild-check && node scripts/inject-version.cjs && tauri build --debug",
    "tauri:build:prod": "npm run validate-env && npm run verify:tools && npm run prebuild-check && node scripts/inject-version.cjs && tauri build --mode production",
    "build:all": "npm run build && npm run tauri:build",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "verify:tools": "node scripts/verify-tools.cjs",
    "prestart": "npm run verify:tools",
    "validate-env": "node scripts/validate-env.cjs",
    "test-version": "node scripts/test-version-detection.cjs",
    "sync-version": "node scripts/version-manager.cjs sync",
    "validate-version": "node scripts/version-manager.cjs validate",
    "update-version": "node scripts/version-manager.cjs update",
    "version-help": "node scripts/version-manager.cjs",
    "test-version-system": "node scripts/test-version-system.cjs",
    "fix-version-detection": "node scripts/fix-version-detection.js",
    "fix-version-detection:auto": "node scripts/fix-version-detection.js --auto-fix",
    "prebuild-check": "node scripts/prebuild-check.js",
    "diagnose-version": "node scripts/fix-version-detection.js",
    "postinstall": "node scripts/validate-env.cjs || echo 'Environment validation skipped during install'"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.19",
    "@fluentui/react-icons": "^2.0.258",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.3.1",
    "@tauri-apps/plugin-fs": "^2.4.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.0",
    "@tauri-apps/plugin-http": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@types/crypto-js": "^4.2.2",
    "classnames": "^2.5.1",
    "crypto-js": "^4.2.0",
    "framer-motion": "^10.16.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^16.3.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.0.1"
  },
  "version": "1.2.0"
}
